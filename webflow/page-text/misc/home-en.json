      "html": "<style>\n#fms-wrap * { margin:0; padding:0; box-sizing:border-box; }\n#fms-wrap {\n  font-family:'Montserrat',sans-serif;\n  width:100%;\n  overflow:hidden;\n  background:#272727;\n}\n\n/* ══ DESKTOP ══ */\n#fms-desktop {\n  display:flex;\n  flex-direction:row;\n  width:100%;\n  height:100vh;\n  overflow:hidden;\n}\n\n/* LEFT PANEL */\n#fms-left {\n  width:22%;\n  flex-shrink:0;\n  background:#e6e5dd;\n  display:flex;\n  flex-direction:column;\n  padding:36px 24px 28px 24px;\n  overflow:hidden;\n}\n#fms-title {\n  font-family:'Montserrat',sans-serif;\n  font-weight:900;\n  font-size:clamp(36px,4.8vw,72px);\n  line-height:0.9;\n  letter-spacing:-0.03em;\n  text-transform:uppercase;\n  color:#f1e09b;\n  word-break:keep-all;\n  hyphens:none;\n}\n#fms-left-photos {\n  margin-top:auto;\n  display:flex;\n  flex-direction:column;\n  gap:6px;\n}\n.fms-lphoto {\n  width:100%;\n  aspect-ratio:3/2;\n  overflow:hidden;\n}\n.fms-lphoto img {\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  display:block;\n}\n\n/* MIDDLE PANEL */\n#fms-mid {\n  flex:1;\n  position:relative;\n  overflow:hidden;\n}\n#fms-mid-img {\n  position:absolute;\n  inset:0;\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  object-position:center center;\n  display:block;\n  transform:scale(1.08);\n}\n#fms-mid-overlay {\n  position:absolute;\n  inset:0;\n  background:linear-gradient(to top,\n    rgba(8,6,3,0.95) 0%,\n    rgba(8,6,3,0.4) 35%,\n    rgba(8,6,3,0.0) 62%\n  );\n}\n#fms-mid-copy {\n  position:absolute;\n  bottom:80px;\n  left:0;\n  right:0;\n  padding:0 36px;\n}\n.fms-mline {\n  display:block;\n  font-family:'Inconsolata',monospace;\n  font-weight:700;\n  font-size:clamp(13px,1.45vw,20px);\n  line-height:1.45;\n  color:#e6e5dd;\n}\n.fms-mline.gold { color:#f1e09b; }\n.fms-mline.gap { margin-top:0.65em; }\n\n/* RIGHT PANEL */\n#fms-right {\n  width:24%;\n  flex-shrink:0;\n  background:#272727;\n  display:flex;\n  flex-direction:column;\n  padding:36px 24px 28px 24px;\n  overflow:hidden;\n}\n#fms-how-label {\n  display:block;\n  font-family:'Inconsolata',monospace;\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:0.26em;\n  text-transform:uppercase;\n  color:#8B3A22;\n  margin-bottom:20px;\n}\n#fms-how-body {\n  font-family:'Inconsolata',monospace;\n  font-size:clamp(11px,1.05vw,15px);\n  line-height:1.82;\n  color:#e6e5dd;\n}\n#fms-how-body em { color:#f1e09b; font-style:normal; }\n#fms-how-note {\n  font-family:'Inconsolata',monospace;\n  font-size:clamp(9px,0.78vw,12px);\n  line-height:1.7;\n  color:rgba(230,229,221,0.35);\n  margin-top:20px;\n}\n#fms-how-note em { color:rgba(241,224,155,0.55); font-style:normal; }\n#fms-btn {\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  margin-top:auto;\n  padding:12px 0;\n  border-radius:6px;\n  background:rgba(139,58,34,0.42);\n  border:1px solid rgba(139,58,34,0.88);\n  font-family:'Inconsolata',monospace;\n  font-weight:700;\n  font-size:10px;\n  letter-spacing:0.24em;\n  text-transform:uppercase;\n  color:#fff;\n  text-decoration:none;\n  transition:background 0.2s;\n  flex-shrink:0;\n}\n#fms-btn:hover { background:rgba(139,58,34,0.82); }\n\n/* ══ MOBILE ══ */\n#fms-mobile { display:none; }\n\n#fms-m1 {\n  min-height:100vh;\n  background:linear-gradient(to bottom,#e6e5dd 0%,#e6e5dd 58%,#272727 100%);\n  padding:clamp(36px,7vh,72px) clamp(16px,5vw,28px) 0;\n  overflow:hidden;\n}\n.fms-mword {\n  display:block;\n  font-family:'Montserrat',sans-serif;\n  font-weight:900;\n  font-size:clamp(60px,21vw,112px);\n  line-height:0.9;\n  letter-spacing:-0.025em;\n  text-transform:uppercase;\n  text-align:justify;\n  text-align-last:justify;\n  color:#f1e09b;\n}\n.fms-mword.fade {\n  background:linear-gradient(to bottom,#f1e09b 0%,#c8a94a 32%,rgba(180,140,20,0.03) 100%);\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n}\n#fms-hint {\n  display:flex;flex-direction:column;align-items:center;gap:5px;\n  padding:20px 0 14px;\n  animation:fmsHint 4s ease 2s both;\n}\n@keyframes fmsHint{0%{opacity:0}20%{opacity:1}75%{opacity:1}100%{opacity:0}}\n#fms-hint span {\n  font-family:'Inconsolata',monospace;font-size:10px;\n  letter-spacing:0.16em;text-transform:uppercase;\n  color:rgba(241,224,155,0.36);\n}\n#fms-arrow {\n  width:12px;height:12px;\n  border-right:1.5px solid rgba(241,224,155,0.26);\n  border-bottom:1.5px solid rgba(241,224,155,0.26);\n  transform:rotate(45deg);\n  animation:fmsBounce 1.8s ease infinite;\n}\n@keyframes fmsBounce{0%,100%{transform:rotate(45deg) translateY(0)}50%{transform:rotate(45deg) translateY(4px)}}\n\n#fms-m2 {\n  min-height:72vh;position:relative;overflow:hidden;\n  display:flex;flex-direction:column;justify-content:flex-end;\n}\n#fms-m2-img {\n  position:absolute;inset:0;width:100%;height:100%;\n  object-fit:cover;object-position:center center;\n  transform:scale(1.06);\n}\n#fms-m2-ov {\n  position:absolute;inset:0;\n  background:linear-gradient(to top,rgba(8,6,3,0.93) 0%,rgba(8,6,3,0.08) 60%,transparent 100%);\n}\n#fms-m2-copy {\n  position:relative;z-index:2;\n  padding:28px 24px 48px;\n}\n.fms-m2line {\n  display:block;font-family:'Inconsolata',monospace;font-weight:700;\n  font-size:clamp(16px,4.5vw,26px);line-height:1.38;color:#e6e5dd;\n}\n.fms-m2line.gold { color:#f1e09b; }\n.fms-m2line.gap { margin-top:0.55em; }\n\n#fms-m3 {\n  background:#272727;\n  border-top:1px solid rgba(241,224,155,0.09);\n  padding:clamp(36px,7vh,60px) clamp(20px,6vw,32px);\n}\n.fms-ml {\n  display:block;font-family:'Inconsolata',monospace;\n  font-size:10px;font-weight:700;letter-spacing:0.24em;text-transform:uppercase;\n  color:#8B3A22;margin-bottom:1.5rem;\n}\n.fms-mb {\n  display:block;font-family:'Inconsolata',monospace;\n  font-size:clamp(15px,4.2vw,20px);line-height:1.8;color:#e6e5dd;margin-bottom:1rem;\n}\n.fms-mb em { color:#f1e09b;font-style:normal; }\n.fms-mf {\n  display:block;font-family:'Inconsolata',monospace;\n  font-size:clamp(12px,3.2vw,14px);line-height:1.68;\n  color:rgba(230,229,221,0.38);margin-bottom:2.2rem;\n}\n.fms-mf em { color:rgba(241,224,155,0.6);font-style:normal; }\n#fms-mbtn {\n  display:flex;align-items:center;justify-content:center;\n  padding:15px 0;border-radius:7px;\n  background:rgba(139,58,34,0.42);border:1px solid rgba(139,58,34,0.88);\n  font-family:'Inconsolata',monospace;font-weight:700;\n  font-size:11px;letter-spacing:0.22em;text-transform:uppercase;\n  color:#fff;text-decoration:none;width:100%;\n}\n\n@media (max-width:768px) {\n  #fms-desktop { display:none !important; }\n  #fms-mobile  { display:block !important; }\n}\n</style>\n\n<div id=\"fms-wrap\">\n\n  <!-- DESKTOP -->\n  <div id=\"fms-desktop\">\n\n    <div id=\"fms-left\">\n      <div id=\"fms-title\">THERE<br>IS<br>NO<br>UNIVERSAL<br>SCENT</div>\n      <div id=\"fms-left-photos\">\n        <div class=\"fms-lphoto\">\n          <img src=\"https://cdn.prod.website-files.com/69773aa3fded0e0107b28cbd/69ea16a610641c56b73ec8e9_hf_20260423_120306_a2ee30be-cbea-41ec-95b7-465b09604c04.png\" alt=\"fireplace\">\n        </div>\n        <div class=\"fms-lphoto\">\n          <img src=\"https://cdn.prod.website-files.com/69773aa3fded0e0107b28cbd/69ea16a59ad19345a33f72de_hf_20260423_122701_32caa851-9d29-41fc-a4c7-7e5a006996f4.png\" alt=\"skiing\">\n        </div>\n      </div>\n    </div>\n\n    <div id=\"fms-mid\">\n      <img id=\"fms-mid-img\" src=\"https://cdn.prod.website-files.com/69773aa3fded0e0107b28cbd/69ea16a620ebb5e2109e7d63_hf_20260423_114818_40fe7b1b-f506-4ced-ba39-73ed05a9ca02.png\" alt=\"ice cream\">\n      <div id=\"fms-mid-overlay\"></div>\n      <div id=\"fms-mid-copy\">\n        <span class=\"fms-mline\">The fragrance industry spends</span>\n        <span class=\"fms-mline\">billions telling you what to buy.</span>\n        <span class=\"fms-mline gold gap\">It has never once asked who you are.</span>\n        <span class=\"fms-mline gold\">This quiz does.</span>\n      </div>\n    </div>\n\n    <div id=\"fms-right\">\n      <span id=\"fms-how-label\">How it works</span>\n      <p id=\"fms-how-body\">Answer with <em>what you feel right now</em> — not with your mind, but with your current state, mood, point in life.</p>\n      <p id=\"fms-how-note\">You're welcome to come back when things change. At the end: one main perfume recommendation, and three others at a lower price point. All chosen for <em>who you are</em> — not for which notes you share.</p>\n      <a id=\"fms-btn\" href=\"https://www.findmysmell.com/q-gender\">Begin</a>\n    </div>\n\n  </div>\n\n  <!-- MOBILE -->\n  <div id=\"fms-mobile\">\n\n    <section id=\"fms-m1\">\n      <span class=\"fms-mword\">THERE</span>\n      <span class=\"fms-mword\">IS NO</span>\n      <span class=\"fms-mword\">UNIVERSAL</span>\n      <span class=\"fms-mword fade\">SCENT</span>\n      <div id=\"fms-hint\"><span>scroll</span><div id=\"fms-arrow\"></div></div>\n    </section>\n\n    <section id=\"fms-m2\">\n      <img id=\"fms-m2-img\" src=\"https://cdn.prod.website-files.com/69773aa3fded0e0107b28cbd/69ea16a620ebb5e2109e7d63_hf_20260423_114818_40fe7b1b-f506-4ced-ba39-73ed05a9ca02.png\" alt=\"ice cream\">\n      <div id=\"fms-m2-ov\"></div>\n      <div id=\"fms-m2-copy\">\n        <span class=\"fms-m2line\">The fragrance industry spends</span>\n        <span class=\"fms-m2line\">billions telling you what to buy.</span>\n        <span class=\"fms-m2line gold gap\">It has never once asked who you are.</span>\n        <span class=\"fms-m2line gold\">This quiz does.</span>\n      </div>\n    </section>\n\n    <section id=\"fms-m3\">\n      <span class=\"fms-ml\">How it works</span>\n      <span class=\"fms-mb\">Answer with <em>what you feel right now</em> —<br>not with your mind, but with your current<br>state, mood, point in life.</span>\n      <span class=\"fms-mf\">You're welcome to come back when things change.<br>At the end: one main perfume recommendation, and three others at a lower price point.<br>All chosen for <em>who you are</em> — not for which notes you share.</span>\n      <a id=\"fms-mbtn\" href=\"https://www.findmysmell.com/q-gender\">Begin</a>\n    </section>\n\n  </div>\n\n</div>",
